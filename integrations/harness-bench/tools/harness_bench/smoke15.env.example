# Manual export reference: fill the values and paste the export commands into your terminal.
# run_smoke15.sh reads only exported variables; no .env file or source command is needed.
# Do not commit the filled file or enable shell tracing (set -x).
export HB_LLM_BASE_URL='https://ark.cn-beijing.volces.com/api/v3'
export HB_LLM_MODEL='<执行模型ID或ep-ID>'
export HB_LLM_API_KEY='<执行模型APIKEY>'

export HB_JUDGE_BASE_URL='https://ark.cn-beijing.volces.com/api/v3'
export HB_JUDGE_MODEL='<裁决模型ID或ep-ID>'
# Empty means reuse HB_LLM_API_KEY; fill a separate key if necessary.
export HB_JUDGE_API_KEY=''
export HARNESSBENCH_JUDGE_TIMEOUT_SEC=300

# Build/download proxy only. Linux local proxy uses host networking for builds.
export HB_PROXY_URL='http://127.0.0.1:7890'
# Model/judge hostnames are automatically put in NO_PROXY; other URLs may use this proxy.
export HB_SERVICE_PROXY_URL='http://127.0.0.1:7890'
# Stop remaining groups when infrastructure/build fails; use 1 to continue.
export HB_CONTINUE_ON_ERROR=0
export HARNESSBENCH_BUILD_ATTEMPTS=3
export HB_WORKERS=1
export HB_MAX_AGENT_TURNS=40
export HB_MAX_TOKENS=8192
export HB_CONTEXT_WINDOW=65536
export HB_TASK_TIMEOUT=2400
export HB_TEMPERATURE=0
# Must match the model's supported reasoning settings.
export HB_THINKING=high
# Optional: absolute output directory; otherwise a fresh timestamp directory.
# export HB_SMOKE_RUN='/absolute/path/to/new-run'
